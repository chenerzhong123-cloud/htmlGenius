{
  "manifest_version": 3,
  "minimum_chrome_version": "116",
  "key": "",
  "name": "htmlGenius",
  "version": "0.9.17",
  "description": "HTML在网页中实时编辑+精确批注修改意见+一键发送给Codex、Claude Code等Agent自动修改+团队共享批注",
  "homepage_url": "https://www.deuce.monster/htmlgenius/",
  "permissions": [
    "activeTab",
    "tabs",
    "sidePanel",
    "storage",
    "identity",
    "nativeMessaging",
    "notifications",
    "offscreen"
  ],
  "host_permissions": [
    "http://localhost/*",
    "http://127.0.0.1/*",
    "https://*/*",
    "file:///*"
  ],
  "side_panel": {
    "default_path": "sidepanel.html"
  },
  "background": {
    "service_worker": "background.js"
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "action": {
    "default_title": "htmlGenius",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "vendor/purify.min.js",
        "text-quote.js",
        "remote-store.js",
        "sync.js",
        "storage.js",
        "artifact-version.js",
        "buildprompt.js",
        "i18n.js",
        "undo.js",
        "palette.js",
        "config.js",
        "content-script.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
